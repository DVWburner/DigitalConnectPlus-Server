<?xml version="1.0" encoding="utf-8"?>
<!-- Optional IIS ARR Reverse-Proxy web.config if fronting Digital Connect+ Server behind IIS -->
<!-- Note: Digital Connect+ Server can ALSO run standalone on Kestrel OR share Port 443 directly with IIS via HTTP.sys mode! -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="262144" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Gen5WRelayProxy" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:8443/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
