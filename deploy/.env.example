# Digital Connect+ Server — Environment Configuration Example
# Leave PUBLIC_URL blank until you enter the domain you purchased!
PUBLIC_URL=
PORT=8443
LISTEN_INTERFACE=0.0.0.0
TLS_MODE=ReverseProxyHttp

# Operator Access Mode:
#   device_pop_only (alias: open)
#   shared_token
#   account_plus_device_pop (alias: accounts)
AUTH_MODE=device_pop_only
SERVER_SHARED_TOKEN=
